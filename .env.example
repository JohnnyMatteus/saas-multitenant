# Copie para .env:  cp .env.example .env && php artisan key:generate
# Valores de DEV apenas. O mesmo arquivo serve a dois propósitos:
#   1) variáveis do docker-compose (portas e senhas dos serviços locais);
#   2) configuração da API quando roda no host (php artisan serve).
# Dentro do Docker, a API recebe as variáveis do bloco x-app-env do compose.

# ---------- docker-compose ----------
APP_PORT=8000
MYSQL_PORT=3307
MYSQL_PASSWORD=dev-only-change-me
MYSQL_ROOT_PASSWORD=dev-only-change-me
REDIS_PORT=6380
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
LOCALSTACK_PORT=4566
STUDIO_MEDIA_BUCKET=studio-media
PROMETHEUS_PORT=9090
ADMINER_PORT=8081

# ---------- API no host ----------
APP_NAME="Agenda de Estúdios"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=json
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=studio
DB_USERNAME=studio
DB_PASSWORD=dev-only-change-me

# file/sync dispensam Redis no host; no Docker são redis/redis.
CACHE_STORE=file
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# REDIS_PORT (acima) é a porta publicada no host e serve aos dois usos.

# Mailpit: UI em http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=agenda@example.com

# Mídia dos estúdios: "local" ou "s3". Com s3 + LocalStack, mantenha o
# endpoint; na AWS real, remova AWS_ENDPOINT e use credenciais de verdade.
STUDIO_MEDIA_DISK=local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=studio-media
AWS_ENDPOINT=http://127.0.0.1:4566
AWS_USE_PATH_STYLE_ENDPOINT=true

# apcu exige a extensão; fora do contêiner use in_memory.
METRICS_STORAGE=in_memory
# Fora de local/testing /metrics exige este token (Bearer) e fecha sem ele.
# METRICS_TOKEN=

# Keycloak do docker-compose.
AUTH_JWT_MODE=jwks
AUTH_JWT_ISSUER=http://localhost:8080/realms/estudios
AUTH_JWT_AUDIENCE=studio-api
AUTH_JWT_JWKS_URI=http://localhost:8080/realms/estudios/protocol/openid-connect/certs
AUTH_JWT_TENANT_CLAIM=tenant
# Modo local (sem IdP): AUTH_JWT_MODE=local e o caminho da chave pública PEM.
# AUTH_JWT_LOCAL_KID=local-dev
# AUTH_JWT_LOCAL_PUBLIC_KEY_PATH=/caminho/para/public.pem
